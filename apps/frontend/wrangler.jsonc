{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grabbin",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "targeted",
    "region": "aws:ap-northeast-2"
  },
  "main": "@tanstack/react-start/server-entry",
  "limits": {
    "cpu_ms": 5000
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "grabbin.me",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "BACKEND",
      "service": "grabbin-api"
    }
  ]
}
