{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frontend",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    {
      "pattern": "grabbin.me",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "BACKEND",
      "service": "backend"
    }
  ]
}
